# Auto-load the pinned Nix devShell via nix-direnv (cached, fast reloads).
# Falls back gracefully to plain `use flake` when nix-direnv is not installed.
if ! has nix_direnv_version; then
  echo "direnv: nix-direnv not found; using plain 'use flake' (slower, uncached)" >&2
fi

use flake

# Machine-local overrides, git-ignored.
[ -f .envrc.local ] && source_env .envrc.local
