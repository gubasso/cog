# EditorConfig for markdown/docs projects, shipped by the cog pre-commit skill.
# Markdown formatting is owned by dprint + markdownlint, and editorconfig-checker
# excludes *.md, so no markdown indent block is set here.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,json5,jsonc,yaml,yml,toml}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
