# EditorConfig for Node.js/TypeScript projects, shipped by the cog pre-commit
# skill. Code indent aligns with prettier (tabWidth 2); markdown is owned by
# prettier/markdownlint.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,jsx,ts,tsx,mjs,cjs,vue,css,scss,html}]
indent_style = space
indent_size = 2

[*.{json,json5,jsonc,yaml,yml,toml}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
