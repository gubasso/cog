use flake

# use flake must stay first — it provides `poetry`. `poetry env info --path`
# locates the venv (stable on Poetry 1.x/2.x; works for in-project .venv or the
# cache dir). Layering it here puts the venv's console-scripts on PATH without a
# manual activation. Create the venv first (`poetry install`), then `direnv reload`.
watch_file pyproject.toml poetry.lock
venv="$(poetry env info --path 2>/dev/null || true)"
if [[ -n "$venv" && -d "$venv" ]]; then
  export VIRTUAL_ENV="$venv"
  export POETRY_ACTIVE=1
  PATH_add "$venv/bin"
fi
