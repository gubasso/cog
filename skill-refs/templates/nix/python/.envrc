# shellcheck shell=bash
# nix-direnv is recommended for evaluation caching only. It is NOT required for
# GC safety: direnv's own `use_flake` runs `nix print-dev-env --profile
# "$(direnv_layout_dir)/flake-profile"`, and a Nix profile generation is a
# permanent GC root (`createGeneration` -> `addPermRoot`), so the devShell's
# store paths survive `nix-collect-garbage` either way.
use flake

# use flake must stay first — it provides `poetry`. `poetry env info --path`
# locates the venv (stable on Poetry 1.x/2.x; works for in-project .venv or the
# cache dir). Layering it here puts the venv's console-scripts on PATH without a
# manual activation. Create the venv first (`poetry install`), then `direnv reload`.
watch_file pyproject.toml poetry.lock
venv="$(poetry env info --path 2>/dev/null || true)"
if [[ -n "$venv" && -d "$venv" ]]; then
  # PATH_add PREPENDS, so the venv shadows the devShell. Any tool provided by
  # both resolves to the venv copy — and for a PyPI *binary wheel* (ruff, typos,
  # committed) that is an ELF hard-coded to /lib64/ld-linux-x86-64.so.2, which
  # cannot exec on a Nix host. `language: system` pre-commit hooks get NO
  # environment patch at all and resolve off exactly this PATH, so a shadowed
  # tool makes the hook die with "[Errno 2] No such file or directory".
  #
  # Keep this list in sync with the paired flake.nix: it holds exactly the tools
  # this template's flake provides AND whose hook is `language: system`. mypy is
  # deliberately absent — its hook is `language: system` too, but it is meant to
  # come from the venv. A project that moves more tools into its flake and marks
  # their hooks `language: system` must add them here.
  #
  # Checked BEFORE PATH_add, and fatal: `log_error` only prints, so warning and
  # continuing would still export the broken PATH and cause the very failure
  # this guards against.
  _shadowed=()
  for _tool in dprint pre-commit; do
    if [[ -x "$venv/bin/$_tool" ]]; then
      _shadowed+=("$_tool")
    fi
  done
  if [[ ${#_shadowed[@]} -gt 0 ]]; then
    log_error "Poetry venv shadows devShell-owned tools: ${_shadowed[*]}"
    log_error "Remove them from the pyproject dev group, then run 'poetry sync'."
    exit 1
  fi
  unset _shadowed _tool

  export VIRTUAL_ENV="$venv"
  export POETRY_ACTIVE=1
  PATH_add "$venv/bin"
else
  log_status "Poetry venv not found — run 'poetry install', then 'direnv reload'."
fi
