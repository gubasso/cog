# Makefile — project task runner.
# Phony targets mirror the justfile recipes; used to reconcile or augment an
# existing Makefile, never to overwrite one. Tailor each command to the toolchain.

.PHONY: lint test build fmt check

# Run linters and static analysis.
lint:
	@echo "TODO: wire lint command"

# Run the test suite.
test:
	@echo "TODO: wire test command"

# Build the project.
build:
	@echo "TODO: wire build command"

# Format the source tree.
fmt:
	@echo "TODO: wire fmt command"

# Format, lint, then test.
check: fmt lint test
