# EditorConfig for C projects.
# C source formatting is owned by clang-format, so no [*.c]/[*.h] indent block
# is set here (avoids fighting the formatter).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,json5,jsonc,yaml,yml,toml}]
indent_style = space
indent_size = 2

# C projects are commonly built by a hand-written upstream Makefile, whose
# recipe lines must be tab-indented to parse at all. This rule protects an
# existing build file; cog itself scaffolds a justfile (ADR-0028).
[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
