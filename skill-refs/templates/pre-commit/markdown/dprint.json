{
  "markdown": {
    "lineWidth": 100,
    "textWrap": "never"
  },
  "json": {
    "trailingCommas": "never"
  },
  "includes": [
    "**/*.md",
    "**/*.{json,jsonc}"
  ],
  "excludes": [
    ".git",
    "node_modules",
    "**/*-lock.json",
    "**/package-lock.json",
    "**/*.jsonl"
  ],
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.22.1.wasm",
    "https://plugins.dprint.dev/json-0.23.0.wasm"
  ]
}
