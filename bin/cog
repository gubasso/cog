#!/usr/bin/env bash
set -euo pipefail
shopt -s inherit_errexit 2>/dev/null || true # bash 4.4+

# Resolve script path through symlinks (stow, make install, ln -s).
src="${BASH_SOURCE[0]}"
while [[ -L $src ]]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ $src != /* ]] && src="$dir/$src"
done
SCRIPT_DIR="$(cd -P "$(dirname "$src")" && pwd)"
readonly SCRIPT_DIR
readonly LIB_DIR="${SCRIPT_DIR}/../lib"

# shellcheck source=../lib/helpers.sh
source "${LIB_DIR}/helpers.sh"
# shellcheck source=../lib/loader.sh
source "${LIB_DIR}/loader.sh"
# shellcheck source=../lib/functions/fn_parse_globals.sh
source "${LIB_DIR}/functions/fn_parse_globals.sh"
# shellcheck source=../lib/functions/fn_config_load.sh
source "${LIB_DIR}/functions/fn_config_load.sh"
# shellcheck source=../lib/functions/fn_help_generate.sh
source "${LIB_DIR}/functions/fn_help_generate.sh"
# shellcheck source=../lib/functions/fn_ui_print.sh
source "${LIB_DIR}/functions/fn_ui_print.sh"
# shellcheck source=../lib/functions/fn_log.sh
source "${LIB_DIR}/functions/fn_log.sh"
# shellcheck source=../lib/functions/fn_error_raise.sh
source "${LIB_DIR}/functions/fn_error_raise.sh"
# shellcheck source=../lib/functions/fn_json_write.sh
source "${LIB_DIR}/functions/fn_json_write.sh"
# shellcheck source=../lib/functions/fn_prereq.sh
source "${LIB_DIR}/functions/fn_prereq.sh"
# shellcheck source=../lib/functions/fn_skill.sh
source "${LIB_DIR}/functions/fn_skill.sh"
# shellcheck source=../lib/functions/fn_review.sh
source "${LIB_DIR}/functions/fn_review.sh"
# shellcheck source=../lib/functions/fn_refactor.sh
source "${LIB_DIR}/functions/fn_refactor.sh"
# shellcheck source=../lib/functions/fn_digest.sh
source "${LIB_DIR}/functions/fn_digest.sh"
# shellcheck source=../lib/functions/fn_rundir.sh
source "${LIB_DIR}/functions/fn_rundir.sh"
# shellcheck source=../lib/functions/fn_longrun.sh
source "${LIB_DIR}/functions/fn_longrun.sh"
# shellcheck source=../lib/functions/fn_executor.sh
source "${LIB_DIR}/functions/fn_executor.sh"
# shellcheck source=../lib/functions/fn_review_loop_input.sh
source "${LIB_DIR}/functions/fn_review_loop_input.sh"
# shellcheck source=../lib/functions/fn_git.sh
source "${LIB_DIR}/functions/fn_git.sh"
# shellcheck source=../lib/functions/fn_queue.sh
source "${LIB_DIR}/functions/fn_queue.sh"
# shellcheck source=../lib/functions/fn_research.sh
source "${LIB_DIR}/functions/fn_research.sh"
# shellcheck source=../lib/functions/fn_plan_slug.sh
source "${LIB_DIR}/functions/fn_plan_slug.sh"
# shellcheck source=../lib/functions/fn_plan_artifact.sh
source "${LIB_DIR}/functions/fn_plan_artifact.sh"
# shellcheck source=../lib/functions/fn_plan_doc.sh
source "${LIB_DIR}/functions/fn_plan_doc.sh"
# shellcheck source=../lib/functions/fn_plan_review.sh
source "${LIB_DIR}/functions/fn_plan_review.sh"
# shellcheck source=../lib/functions/fn_tracking.sh
source "${LIB_DIR}/functions/fn_tracking.sh"
# shellcheck source=../lib/functions/fn_toml.sh
source "${LIB_DIR}/functions/fn_toml.sh"
# shellcheck source=../lib/functions/fn_power_grade.sh
source "${LIB_DIR}/functions/fn_power_grade.sh"
# shellcheck source=../lib/functions/fn_review_plan_implementation.sh
